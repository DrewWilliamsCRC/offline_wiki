<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- xcodebuild -exportArchive options for a TestFlight upload (see "TestFlight" in CLAUDE.md).
	     Each upload goes to the internal testers and can also be chosen for an App Store version.
	     (testFlightInternalTestingOnly would mark it internal only, and App Store Connect will not
	     add such a build to a version for review.) Xcode raises the build number past the last one
	     uploaded (manageAppVersionAndBuildNumber).
	     There is no teamID: the export uses the team the archive was signed for, and this
	     repository is public. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
